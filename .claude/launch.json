{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "apps/web"
      ],
      "port": 5173
    },
    {
      "name": "vai",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "scripts/serve.py"
      ],
      "port": 8765
    },
    {
      "name": "api",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set VAI__DAILY__ENABLED=false&& .venv\\Scripts\\python.exe scripts/serve.py --no-worker"
      ],
      "port": 8765
    }
  ]
}
