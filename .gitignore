# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.pytest-tmp/
.tmp/
.coverage
coverage.xml
htmlcov/
.ruff_cache/

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo

# Rust / Tauri
target/

# Everything the application runs on, kept beside it rather than on the system
# drive (scripts/rooted.py). Bundled binaries and a multi-gigabyte virtual
# environment are the machine's, not the repository's.
/tools/
/.cache/

# Application data - never commit user media, models, logs or databases
/projects/*
!/projects/.gitkeep
/models/*
!/models/.gitkeep
/input/*
!/input/.gitkeep
/output/*
!/output/.gitkeep
/logs/
# The data root is the repository root on this machine, so anything the
# running system writes lands here: the showcase run is 8 GB of renders and
# databases, the sound-effect pack and the daily reports are produced rather
# than authored.
/.showcase/
/assets/
/reports/
*.db
*.db-wal
*.db-shm

# Local overrides
config/*.local.yaml
.env
.env.local

# OS
.DS_Store
Thumbs.db

# Owner-only credentials: the OAuth client secret and the granted YouTube
# token. The packager refuses to ship this directory; git must never see it.
.credentials/

# Animation runtime by-products: rendered frames, Godot's editor cache, and
# the synthesised stand-in audio -- all regenerated, never reviewed.
/animation/out/
/animation/godot/.godot/
/animation/assets/
